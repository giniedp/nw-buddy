{
  "name": "@nw-buddy/viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "module": "./dist/lib/nw-viewer.module.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lib/nw-viewer.module.js"
    },
    "./app": {
      "types": "./dist/types/app.d.ts",
      "import": "./dist/lib/nw-viewer-app.module.js"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm build:app && pnpm build:lib",
    "build:app": "tsc && vite build",
    "build:lib": "vite build --mode=lib && pnpm build:types",
    "build:types": "tsc -p tsconfig.lib.json",
    "dev:lib": "vite build --mode=lib --watch",
    "build:zip": "pnpm build:app && pnpm zip",
    "zip": "node scripts/zip-app.mjs",
    "preview": "vite preview",
    "test": "vitest",
    "icon": "node scripts/fa-icon.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@vitest/browser": "^5.0.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@webgpu/types": "^0.1.74",
    "esbuild": "0.28.1",
    "playwright": "1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@gglib/components": "file:../../../glib/packages/components",
    "@gglib/content": "file:../../../glib/packages/content",
    "@gglib/ecs": "file:../../../glib/packages/ecs",
    "@gglib/effects": "file:../../../glib/packages/effects",
    "@gglib/game": "file:../../../glib/packages/game",
    "@gglib/graphics": "file:../../../glib/packages/graphics",
    "@gglib/loaders": "file:../../../glib/packages/loaders",
    "@gglib/math": "file:../../../glib/packages/math",
    "@gglib/model": "file:../../../glib/packages/model",
    "@gglib/render": "file:../../../glib/packages/render",
    "@gglib/utils": "file:../../../glib/packages/utils",
    "@gglib/vite-plugin": "file:../../../glib/packages/vite-plugin",
    "@solidjs/router": "0.15.3",
    "ag-grid-community": "35.3.1",
    "fflate": "0.8.3",
    "monaco-editor": "0.52.2",
    "solid-js": "^1.9.17",
    "tweak-ui": "file:../../../tweak-ui"
  }
}
